# Template only — copy to `.env.local` (which is gitignored) for real values.
#
#     copy .env.example .env.local
#
# Vite only exposes variables prefixed with VITE_, and everything here is
# embedded into the built JavaScript. Nothing in this file is a secret in the
# "must never be seen" sense — Firebase web config is public by design, and the
# admin value below is a hash, not a password. What protects the data is the
# Firestore rules file, not the secrecy of these keys.

# --- Firebase (required for shared content) ----------------------------------
# Firebase console -> Project settings -> General -> Your apps -> Web app config.
# Leave blank to fall back to a localStorage-only store, in which case admin
# edits stay in the browser that made them and visitors never see them.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Admin sign-in -----------------------------------------------------------
# With Firebase configured above, sign-in uses Firebase Authentication and these
# four are ignored entirely. There is no password to put anywhere: the admin
# account lives in Firebase console -> Authentication -> Users.
#
# They are the fallback for running without Firebase. In that mode, do NOT fill
# them in by hand and do NOT put a plaintext password here. Run this from the
# repository root instead:
#
#     npm run set-admin-password
#
# It prompts for a password, then writes the id, a random salt and a
# PBKDF2-SHA256 hash into .env.local. The plaintext is never stored.
#
# Read the header comment in src/composables/useAuth.js before relying on this
# for anything: a browser-only login on a static host is bypassable by design.
VITE_ADMIN_ID=
VITE_ADMIN_PW_SALT=
VITE_ADMIN_PW_HASH=
VITE_ADMIN_PW_ITERATIONS=310000
