# Template only — copy to `.env.local` (which is gitignored) for real values.

# --- Admin sign-in -----------------------------------------------------------
# Do NOT fill these in by hand and do NOT put a plaintext password here.
# Run this from the repository root instead:
#
#     npm run set-admin-password
#
# It prompts for the password, then writes the id, a random salt and a
# PBKDF2-SHA256 hash into .env.local. The plaintext is never stored.
#
# Read the header comment in src/composables/useAuth.js before relying on this
# for anything: a browser-only login on a static host is bypassable by design.
VITE_ADMIN_ID=
VITE_ADMIN_PW_SALT=
VITE_ADMIN_PW_HASH=
VITE_ADMIN_PW_ITERATIONS=310000

# --- Firebase (optional, currently unused) -----------------------------------
# Leave blank to keep the localStorage-only store. Filling these in re-enables
# the dormant Firestore sync in src/composables/useContent.js, which is what
# makes admin edits visible to visitors rather than only in your own browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
