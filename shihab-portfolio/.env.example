# Copy this file to `.env.local` and fill in your Firebase web-app values.
# Without these the portfolio still runs, using localStorage as the store.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dev-only admin credentials used when Firebase Auth is not configured.
VITE_ADMIN_ID=admin
VITE_ADMIN_PASSWORD=password1234

# Optional: when set, the admin panel signs in with Firebase Auth
# (email/password) instead of the dev credentials above.
VITE_ADMIN_EMAIL=
